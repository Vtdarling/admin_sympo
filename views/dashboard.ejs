<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | TechSymposium '26</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        
        /* Navbar Styling */
        .navbar-admin {
            background: linear-gradient(90deg, #212529, #343a40);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        /* Stat Cards */
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border: none;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }
        
        .stat-card.blue::after { background: #0d6efd; }
        .stat-card.purple::after { background: #6f42c1; }
        .stat-card.orange::after { background: #fd7e14; }
        .stat-card.teal::after { background: #20c997; }

        .stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
        }

        /* Table Styling */
        .table-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            overflow: hidden;
            border: none;
        }
        
        .table thead th {
            background-color: #f8f9fa;
            color: #6c757d;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            padding: 15px;
            border-bottom: 2px solid #e9ecef;
        }
        
        .table tbody td {
            padding: 15px;
            vertical-align: middle;
            color: #495057;
            font-size: 0.95rem;
        }
        
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
        }

        /* Custom Badge */
        .custom-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Action Buttons */
        .btn-action {
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        /* Print Specific Styles */
        @media print {
            .navbar-admin, .btn, .stat-card, .no-print { display: none !important; }
            .table-container { box-shadow: none; border: 1px solid #ddd; }
            body { background-color: white; }
            .badge { border: 1px solid #000; color: #000 !important; background: none !important; }
        }
    </style>
</head>
<body>

    <!-- Admin Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin sticky-top mb-4 animate__animated animate__fadeInDown">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
                <div class="bg-danger rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                    <i class="fas fa-shield-alt text-white fs-6"></i>
                </div>
                <span>Admin<span class="fw-light">Panel</span></span>
            </a>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-md-flex align-items-center text-white-50">
                    <span class="me-2">Welcome, Administrator</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        
        <!-- Stats Row -->
        <div class="row g-4 mb-5 animate__animated animate__fadeInUp">
            
            <!-- Total Participants -->
            <div class="col-md-3">
                <div class="stat-card blue">
                    <div>
                        <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Total Registrations</h6>
                        <h2 class="mb-0 fw-bold text-dark"><%= stats.total %></h2>
                        <small class="text-primary fw-bold"><i class="fas fa-users me-1"></i>All time</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-user-graduate fa-2x text-primary"></i>
                    </div>
                </div>
            </div>

            <!-- Technical Events -->
            <div class="col-md-3">
                <div class="stat-card purple">
                    <div>
                        <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Technical Events</h6>
                        <h2 class="mb-0 fw-bold text-dark"><%= stats.technical %></h2>
                        <small class="text-purple fw-bold" style="color: #6f42c1;"><i class="fas fa-microchip me-1"></i>Registered</small>
                    </div>
                    <div class="bg-opacity-10 p-3 rounded-circle" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="fas fa-code fa-2x" style="color: #6f42c1;"></i>
                    </div>
                </div>
            </div>

            <!-- Non-Technical Events -->
            <div class="col-md-3">
                <div class="stat-card orange">
                    <div>
                        <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Non-Technical</h6>
                        <h2 class="mb-0 fw-bold text-dark"><%= stats.nonTechnical %></h2>
                        <small class="text-warning fw-bold text-dark"><i class="fas fa-gamepad me-1"></i>Registered</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-dice fa-2x text-warning text-dark"></i>
                    </div>
                </div>
            </div>

            <!-- Colleges -->
            <div class="col-md-3">
                <div class="stat-card teal">
                    <div>
                        <h6 class="text-secondary text-uppercase fw-bold mb-2" style="font-size: 0.75rem;">Colleges Partici...</h6>
                        <h2 class="mb-0 fw-bold text-dark"><%= stats.colleges %></h2>
                        <small class="text-success fw-bold" style="color: #20c997;"><i class="fas fa-university me-1"></i>Unique</small>
                    </div>
                    <div class="bg-opacity-10 p-3 rounded-circle" style="background-color: rgba(32, 201, 151, 0.1);">
                        <i class="fas fa-building fa-2x" style="color: #20c997;"></i>
                    </div>
                </div>
            </div>

        </div>

        <!-- Data Table Section -->
        <div class="table-container animate__animated animate__fadeInUp animate__delay-1s">
            
            <!-- Table Header with Actions -->
            <div class="d-flex flex-wrap justify-content-between align-items-center p-4 border-bottom bg-white">
                <div>
                    <h5 class="mb-1 fw-bold text-dark">Participant List</h5>
                    <p class="text-muted small mb-0">Manage and view all student registrations</p>
                </div>
                <div class="d-flex gap-2">
                     <button onclick="window.location.reload()" class="btn btn-outline-info btn-sm rounded-pill fw-bold px-3 d-flex align-items-center hover-scale">
                    <i class="fas fa-sync-alt me-2"></i> Refresh Data
                </button>
                    <a href="/export-excel" class="btn btn-action btn-success text-white border-0 text-decoration-none">
                        <i class="fas fa-file-excel me-2"></i>Export Excel
                    </a>
                    <a href="/export-pdf" class="btn btn-action btn-danger text-white border-0 text-decoration-none">
                        <i class="fas fa-file-pdf me-2"></i>Download PDF
                    </a>
                    <button class="btn btn-action btn-dark text-white border-0" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>Print List
                    </button>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="participantsTable">
                    <thead>
                        <tr>
                            <th class="ps-4">Reg ID</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Institution</th>
                            <th>Events Selected</th>
                            <th>Trans ID</th>
                            <th>Registered On</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length > 0) { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-dark text-white rounded-pill px-3 py-2">
                                            #<%= user.event_id || 'N/A' %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= user.name %></div>
                                    </td>
                                    <td>
                                        <div class="small text-muted"><i class="fas fa-envelope me-1 text-primary"></i> <%= user.email %></div>
                                        <div class="small text-muted"><i class="fas fa-phone-alt me-1 text-success"></i> <%= user.phone %></div>
                                    </td>
                                    <td class="fw-semibold text-secondary"><%= user.college %></td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <% if(user.technical_event && user.technical_event !== 'None') { %>
                                            <span class="custom-badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                                <i class="fas fa-microchip me-1"></i> <%= user.technical_event %>
                                            </span>
                                            <% } %>
                                            <% if(user.non_technical_event && user.non_technical_event !== 'None') { %>
                                            <span class="custom-badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 text-dark">
                                                <i class="fas fa-gamepad me-1"></i> <%= user.non_technical_event %>
                                            </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-muted bg-light px-2 py-1 rounded border d-inline-block text-monospace">
                                            <%= user.transaction_id || '-' %>
                                        </div>
                                    </td>
                                    <td class="text-secondary small">
                                        <div class="fw-bold"><%= new Date(user.registeredAt).toLocaleDateString() %></div>
                                        <div><%= new Date(user.registeredAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted opacity-50 mb-2">
                                        <i class="fas fa-folder-open fa-3x"></i>
                                    </div>
                                    <p class="text-muted fw-bold">No registrations found yet</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>