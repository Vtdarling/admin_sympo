<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | TechSymposium</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark-gradient shadow-sm sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" href="#">
                <i class="fas fa-shield-alt text-warning me-2"></i> ADMIN PANEL
            </a>
            <div class="d-flex align-items-center">
                <a href="/" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container py-5">

        <!-- Stats Card -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm gradient-card text-white rounded-4">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 opacity-75">Total Registrations</h6>
                            <h2 class="display-4 fw-bold mb-0"><%= students.length %></h2>
                        </div>
                        <div class="icon-circle bg-white text-primary">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center">
                <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-list-alt me-2"></i> Student Database</h5>
            </div>
            
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted text-uppercase small">
                            <tr>
                                <th class="ps-4 py-3">#</th>
                                <th class="py-3">Student Name</th>
                                <th class="py-3">College</th>
                                <th class="py-3">Contact</th>
                                <th class="py-3">Events</th>
                                <th class="py-3 text-end pe-4">Date</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white">
                            <% if(students.length > 0) { %>
                                <% students.forEach((student, index) => { %>
                                    <tr>
                                        <td class="ps-4 fw-bold text-secondary"><%= index + 1 %></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-3"><%= student.name.charAt(0) %></div>
                                                <div class="fw-bold text-dark"><%= student.name %></div>
                                            </div>
                                        </td>
                                        <td><%= student.college %></td>
                                        <td>
                                            <div class="small text-muted"><i class="fas fa-phone me-2"></i><%= student.phone %></div>
                                        </td>
                                        <td>
                                            <% if (student.events.length > 0) { %>
                                                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
                                                    <%= student.events.length %> Events
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-light text-muted">None</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-4 text-muted small">
                                            <%= student.timestamp.toLocaleDateString() %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <h5>No data found</h5>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Download Buttons Section -->
        <div class="text-center animate-up d-flex justify-content-center gap-3">
            
            <!-- Excel Button -->
            <a href="/export-excel" class="btn btn-success btn-lg rounded-pill shadow-lg px-4 py-3 fw-bold hover-lift">
                <i class="fas fa-file-excel me-2"></i> Download Excel
            </a>

            <!-- PDF Button (New) -->
            <a href="/export-pdf" class="btn btn-danger btn-lg rounded-pill shadow-lg px-4 py-3 fw-bold hover-lift">
                <i class="fas fa-file-pdf me-2"></i> Download PDF
            </a>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>